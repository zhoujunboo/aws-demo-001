AGENT_API_KEY=replace-with-agent-api-key
AGENT_TIMEOUT_SECONDS=25
DATABASE_URL=postgres://postgres:password@localhost:5432/githubprofile?sslmode=disable

# Configure all four values together to enable vector retrieval and reranking.
# BASE_URL should expose POST /embeddings and POST /rerank using the formats supported by this service.
MATCHING_AI_API_KEY=replace-with-matching-api-key
MATCHING_AI_BASE_URL=https://example.com/v1
MATCHING_EMBEDDING_MODEL=replace-with-embedding-model
MATCHING_RERANK_MODEL=replace-with-rerank-model
MATCHING_RERANK_URL=https://example.com/api/v1/services/rerank/text-rerank/text-rerank
MATCHING_AI_TIMEOUT_SECONDS=10
